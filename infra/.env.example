# Coordinator
# gRPC (nodes) listens on GRPC_PORT, this is the port a real deployment exposes
# to the internet for contributors to reach. REST (Zonn Console) listens on
# HTTP_PORT but docker-compose.yml only ever binds it to the host's loopback
# interface, since it has no auth of its own and Zonn Console reaches it over
# the internal Docker network regardless.
COORDINATOR_GRPC_PORT=8080
COORDINATOR_HTTP_PORT=8081
# Public WebSocket relay URL for remote jobs, for example
# ws://7.tcp.eu.ngrok.io:12345/relay. Leave blank for local-only jobs.
COORDINATOR_RELAY_URL=
NODE_OFFLINE_AFTER_SECONDS=15
HEARTBEAT_INTERVAL_SECONDS=5
REAPER_INTERVAL_SECONDS=3

# Zonn Console
ADMIN_DASHBOARD_PORT=3000
# Change these before deploying anywhere reachable by anyone but you.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Signs the admin session cookie. Required for a real deployment: generate one
# with `openssl rand -hex 32` and paste it here. If left blank, the app falls
# back to a fixed value that is visible in the source code, which means anyone
# could forge a valid session and sign in as admin without a password.
AUTH_SECRET=

# LLM runner
DEFAULT_MODEL=microsoft/Phi-3-mini-4k-instruct
